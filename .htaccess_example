
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Bloquea listados de directorios sin impedir archivos reales.
    RewriteRule ^(css|js|php|resources|vendor)/?$ - [F,L]

    # Sirve archivos y directorios reales sin tocar.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

<IfModule php8_module>
   php_flag display_errors Off
   php_value error_log "error_log"
   php_flag log_errors On
   php_value max_execution_time 120
   php_value max_input_time 120
   php_value max_input_vars 1000
   php_value memory_limit 256M
   php_value post_max_size 50M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php82"
   php_value upload_max_filesize 50M
   php_flag zlib.output_compression Off
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors Off
   php_value error_log "error_log"
   php_flag log_errors On
   php_value max_execution_time 120
   php_value max_input_time 120
   php_value max_input_vars 1000
   php_value memory_limit 256M
   php_value post_max_size 50M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php82"
   php_value upload_max_filesize 50M
   php_flag zlib.output_compression Off
</IfModule>
