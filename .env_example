APP_NAME="Media PHPeitor"
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_BASE_URL=http://127.0.0.1/gallery

# Session cookies. Set SESSION_COOKIE_SECURE=true when serving over HTTPS.
SESSION_COOKIE_PATH=/gallery/
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Required secrets: use strong, unique values and never commit .env.
GALLERY_TOKEN=replace-with-a-long-random-gallery-token
UPLOAD_TOKEN=replace-with-a-different-long-random-upload-token
GALLERY_SESSION_TTL_SECONDS=43200
UPLOAD_SESSION_TTL_SECONDS=43200
TOKEN_MAX_ATTEMPTS=3
TOKEN_LOCK_SECONDS=300

# Gallery and media processing.
GALLERY_PAGE_SIZE=12
GALLERY_MAX_PAGE_SIZE=50
HOME_SLIDER_LIMIT=5
GALLERY_THUMB_WIDTH=640
GALLERY_THUMB_QUALITY=78

# Upload guardrails. A size of 0 delegates file-size limits to PHP's upload_max_filesize/post_max_size.
UPLOAD_MAX_FILES=20
UPLOAD_MAX_FILE_SIZE_MB=0
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# Public relative endpoint paths. Only these routes are exposed to browser code; secrets stay server-side.
API_TOKEN_VALIDATE=php/token_validate.php
API_CHECK_TOKEN=php/check_token.php
API_LOGOUT=php/logout.php
API_MENU=php/menu.php
API_HOME_SLIDER=php/home_slider.php
API_MEDIA=php/media.php
API_LIST=php/list.php
API_ZIP=php/zip.php
API_DELETE_IMAGE=php/delete_image.php
API_CHECK_UPLOAD_TOKEN=php/check_upload_token.php
API_UPLOAD_TOKEN_VALIDATE=php/upload_token_validate.php
API_CREATE_FOLDER=php/create_folder.php
API_UPLOAD=php/upload.php
